{
  "name": "gitbud",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "@types/react": "^19.1.8",
      "@types/react-dom": "^19.1.6",
      "typescript": "~5.8.3",
      "vite": "^7.0.4",
      "@vitejs/plugin-react": "^4.6.0",
      "@tailwindcss/vite": "^4.3.3",
      "@tailwindcss/postcss": "^4.3.3",
      "tailwindcss": "^4.3.3",
      "@radix-ui/react-checkbox": "^1.3.11",
      "@radix-ui/react-context-menu": "^2.3.7",
      "@radix-ui/react-dialog": "^1.1.23",
      "@radix-ui/react-dropdown-menu": "^2.1.24",
      "@radix-ui/react-popover": "^1.1.23",
      "@radix-ui/react-select": "^2.3.7",
      "@radix-ui/react-slider": "^1.4.7",
      "@radix-ui/react-slot": "^1.3.3",
      "@radix-ui/react-tooltip": "^1.2.16",
      "@tanstack/react-virtual": "^3.14.10",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.6.0",
      "lucide-react": "^1.33.0",
      "sonner": "^2.0.8",
      "highlight.js": "^11.12.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint:js": "NODE_OPTIONS=--experimental-strip-types oxlint .",
    "lint:rust": "cargo clippy --quiet --manifest-path apps/desktop/src-tauri/Cargo.toml -- -D warnings",
    "lint": "bun run lint:js && bun run lint:rust",
    "format:js": "NODE_OPTIONS=--experimental-strip-types oxfmt .",
    "format:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "format": "bun run format:js && bun run format:rust",
    "format:check:js": "NODE_OPTIONS=--experimental-strip-types oxfmt --check .",
    "format:check:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check",
    "format:check": "bun run format:check:js && bun run format:check:rust",
    "quality": "bun scripts/check-dead-code.ts && bun scripts/check-duplicate-deps.ts",
    "dev:desktop": "turbo run dev --filter=@gitbud/desktop",
    "build:desktop": "turbo run build --filter=@gitbud/desktop",
    "check:desktop": "turbo run check --filter=@gitbud/desktop",
    "dev:landing": "turbo run dev --filter=@gitbud/landing",
    "build:landing": "turbo run build --filter=@gitbud/landing",
    "check:landing": "turbo run check --filter=@gitbud/landing",
    "tauri": "bun run --cwd apps/desktop tauri",
    "version:bump:desktop": "bun run --cwd apps/desktop version:bump",
    "ui:add": "cd packages/ui && bunx shadcn@latest add"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "turbo": "^2.5.0"
  },
  "overrides": {
    "fsevents": "^2.3.3",
    "postcss": "8.5.23",
    "semver": "^7.8.5"
  },
  "packageManager": "bun@1.4.0"
}
