{
  "name": "gitbud",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "@types/react": "^19.1.8",
      "@types/react-dom": "^19.1.6",
      "typescript": "~5.8.3",
      "vite": "^7.0.4",
      "@vitejs/plugin-react": "^4.6.0",
      "@tailwindcss/vite": "^4.3.3",
      "tailwindcss": "^4.3.3",
      "@radix-ui/react-checkbox": "^1.3.11",
      "@radix-ui/react-context-menu": "^2.3.7",
      "@radix-ui/react-dialog": "^1.1.23",
      "@radix-ui/react-dropdown-menu": "^2.1.24",
      "@radix-ui/react-popover": "^1.1.23",
      "@radix-ui/react-slider": "^1.4.7",
      "@radix-ui/react-slot": "^1.3.3",
      "@radix-ui/react-tooltip": "^1.2.16",
      "@tanstack/react-virtual": "^3.14.10",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.6.0",
      "lucide-react": "^1.33.0",
      "sonner": "^2.0.8",
      "highlight.js": "^11.12.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "dev:desktop": "turbo run dev --filter=@gitbud/desktop",
    "build:desktop": "turbo run build --filter=@gitbud/desktop",
    "check:desktop": "turbo run check --filter=@gitbud/desktop",
    "tauri": "bun run --cwd apps/desktop tauri",
    "version:bump:desktop": "bun run --cwd apps/desktop version:bump",
    "ui:add": "cd packages/ui && bunx shadcn@latest add"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
