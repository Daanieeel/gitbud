{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitBud",
  "version": "0.1.2",
  "identifier": "com.gitbud.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitBud",
        "width": 1200,
        "height": 900,
        "minWidth": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "resources/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4QUIyMzZFMDlFOUZFODAKUldTQS91a0piaU9yK0k0TUJSczZMdDRZTllhcjhKQ0FYWmpCRThhSXdiU1BoY0o1WWVjYk5tTzcK",
      "endpoints": [
        "https://github.com/Daanieeel/gitbud/releases/latest/download/latest.json"
      ]
    }
  }
}
