{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitBud",
  "version": "0.5.2",
  "identifier": "com.gitbud.app",
  "build": {
    "beforeDevCommand": "bun run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitBud",
        "width": 1200,
        "height": 900,
        "minWidth": 1100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "resources/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGOTc1NjNEOEMyRTA0QzEKUldUQkJDNk1QVmFYejlsV2lTWmRpY3RXQzFXd3lnelcyWUpTYi8xdUhXY2tiNlQ5K3VqeXJGdHgK",
      "endpoints": ["https://github.com/Daanieeel/gitbud/releases/latest/download/latest.json"]
    }
  }
}
